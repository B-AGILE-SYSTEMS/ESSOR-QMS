# Copier en .env puis REMPLACER toutes les valeurs "a-changer". Ne jamais committer .env.

# URL publique du serveur (vue par les navigateurs et l'application mobile), sans / final.
ESSOR_PUBLIC_URL=http://localhost
# Port HTTP exposé par Nginx.
ESSOR_HTTP_PORT=80
# true dès que le site est servi en HTTPS.
ESSOR_COOKIE_SECURE=false

# PostgreSQL : rôle propriétaire (migrations) et rôle applicatif essor_app (soumis à la RLS).
POSTGRES_OWNER_PASSWORD=a-changer
ESSOR_DB_APP_PASSWORD=a-changer
KEYCLOAK_DB_PASSWORD=a-changer

# Keycloak : administrateur de la console (/auth/admin) et secret du client confidentiel essor-bff.
KEYCLOAK_ADMIN=admin-keycloak
KEYCLOAK_ADMIN_PASSWORD=a-changer
ESSOR_OIDC_CLIENT_SECRET=a-changer

# Tenant attribué aux utilisateurs sans attribut Keycloak "tenant".
ESSOR_DEFAULT_TENANT_CODE=DEMO
